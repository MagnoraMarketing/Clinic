# ============================================================================
# AIbooking Clinic – environment variables
# Copy to .env.local (locally) or set in Vercel → Project → Settings → Environment Variables.
# NEVER commit real keys. Only NEXT_PUBLIC_* is sent to the browser.
# ============================================================================

# --- Public (browser) -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://clinic.aibooking.dk
# AIbooking Voice/Chat widget.
#   *.js       => loaded as a script (data-agent-id, data-clinic-id, window.AIbookingConfig)
#   other URL  => shown as an iframe
#   empty ("") => built-in English demo receptionist (chat + voice in the browser)
#   omitted    => AIbooking "Clinic" agent (https://aibooking-backendnew.vercel.app/widget.js)
NEXT_PUBLIC_AIBOOKING_WIDGET_URL=https://aibooking-backendnew.vercel.app/widget.js
# Widget id for the script widget (data-widget-id)
NEXT_PUBLIC_AIBOOKING_WIDGET_ID=NuQB1HFdM8Q3MI
# Vapi voice assistant (optional). When the public key is set, the site's widget uses
# the Vapi assistant instead of the script widget above – same design as the rest of the site.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=3f71f796-263a-40e9-8341-ea52bc820b32
# Default agent id (can be overridden per clinic in admin → AI receptionist / table ai_agents)
NEXT_PUBLIC_AIBOOKING_AGENT_ID=
# Optional central AIbooking API. Empty = this app's own /api routes.
NEXT_PUBLIC_AIBOOKING_API_URL=

# --- Platform --------------------------------------------------------------------
# true = public sales demo (no login for /admin). Set false in production.
DEMO_MODE=true
DEFAULT_CLINIC_SLUG=calm-hands
# Phone number for "Call the demo line" (the AI phone line). Empty = placeholder.
AIBOOKING_DEMO_PHONE=

# --- Admin (only when DEMO_MODE=false) -----------------------------------------------
ADMIN_PASSWORD=
# Long random string, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Bearer key for server-to-server calls (practice systems, scripts): Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=

# --- AIbooking Voice / webhooks --------------------------------------------------------
# Key AIbooking Voice uses against /api/appointments/lookup (caller-ID lookup), /api/calls and /api/webhooks
AIBOOKING_API_KEY=
# HMAC secret for X-AIbooking-Signature on inbound webhooks
AIBOOKING_WEBHOOK_SECRET=

# --- Supabase (empty = in-memory demo store) --------------------------------------------
SUPABASE_URL=
# Server-side only! Must never have a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Calendar sync (optional) ------------------------------------------------------------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# --- Practice / journal system, SMS and custom API (optional, signed webhooks) --------------
PRACTICE_SYSTEM_WEBHOOK_URL=
SMS_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_SECRET=

# --- Leads from "Book a demo" (optional, e.g. Slack/CRM webhook) ----------------------------
LEADS_WEBHOOK_URL=
